---
exclude_paths:
  - zuul.d/
  - .tox
mock_modules:
  - zuul_return
mock_roles:
  - emit-job-header
  - ensure-output-dirs
  - generate-zuul-manifest
  - local-log-download
  - log-inventory
  - prepare-workspace-git
  - set-zuul-log-path-fact
  - stage-output
  - start-zuul-console
  - validate-host
quiet: false
skip_list:
  - command-instead-of-module
  - fqcn[action-core]
  - name[play]
  - no-changed-when
  - risky-file-permissions
  - risky-shell-pipe
  - role-name
verbosity: 1
